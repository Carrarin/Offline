# The calorimeter "machine" on raw calorimeter data (calorimeter only).
#
# Chain:
#   CaloDigis (Offline decoder)
#   -> MC2CaloRecoDigiMaker     MC2 template fit; time offsets and energy scale from the CalCalib conditions
#   -> MC2CaloHitMaker          Offline CaloHitMaker on our reco digis; L and R merged within 50 ns (robust to time jumps)
#   -> MC2CaloCosmicTrackFinder cosmic tracks in the calorimeter
#   -> analyzers:
#      dump     MC2CaloCosmicTrackDump   tracks, in the format of the mc2tools tagger
#      calib    MC2CaloCalibFromTracks   our tables: CalTimeCalib, CalEnergyCalib, CalSimCrystals, CalBaselines, response
#      stopped  MC2StoppedMuons          delayed deposits, Michel spectra per disk, lifetime
#      capture  MC2MuCapture             mu- capture: second pulse in the stopping crystal
#
# This file is the common part: Offline/MC2Reco/scripts/run_machine.sh appends to a copy of it, for every pass, the
# calibration tables to use (DbService.textFile), the analyzers to run and the names of the output tables.
#
# Usage: mu2e -c <pass fcl> -S <raw list> -T <out.root>
#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"
#include "Offline/DAQ/fcl/prolog.fcl"
#include "Offline/CaloReco/fcl/prolog.fcl"
#include "Offline/MC2Reco/fcl/prolog.fcl"
process_name : MC2CaloMachine
source   : { module_type : RootInput }
services : @local::Services.Reco
physics : {
   producers : {
      CaloDigis                : { @table::DAQ.producers.CaloDigis }
      MC2CaloRecoDigiMaker     : { @table::MC2Reco.MC2CaloRecoDigiMaker useCalCalibTimeOffset : true }
      MC2CaloHitMaker          : { @table::CaloReco.CaloHitMaker
                                   caloRecoDigiCollection : MC2CaloRecoDigiMaker
                                   time4Merge             : 50. }
      MC2CaloCosmicTrackFinder : { @table::MC2Reco.MC2CaloCosmicTrackFinder }
   }
   analyzers : {
      dump    : { @table::MC2Reco.MC2CaloCosmicTrackDump }
      calib   : { @table::MC2Reco.MC2CaloCalibFromTracks }
      stopped : { @table::MC2Reco.MC2StoppedMuons }
      capture : { @table::MC2Reco.MC2MuCapture }
   }
   reco : [ CaloDigis, MC2CaloRecoDigiMaker, MC2CaloHitMaker, MC2CaloCosmicTrackFinder ]
   ana  : [ dump, calib, stopped, capture ]
   trigger_paths : [ reco ]
   end_paths     : [ ana ]
}
services.GeometryService.inputFile : "Offline/Mu2eG4/geom/geom_common_extracted.txt"
services.scheduler.wantSummary : true

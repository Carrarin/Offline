# Muonic X-rays of Cs and I seen by the LYSO (CAPHRI) crystals: mu- almost at rest in a box around one LYSO and its CsI neighbours
# (gun_lyso<id>.txt), Geant4 ShieldingM (EMCascade + nuclear capture), MC2 calorimeter response and reconstruction, MC2 hall geometry.
# Output: tree xray of MC2MuXrayAna (TFileService); no art output.
#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardProducers.fcl"
#include "Offline/fcl/standardServices.fcl"
#include "Offline/CaloMC/fcl/prolog.fcl"
#include "Offline/CaloReco/fcl/prolog.fcl"
#include "Offline/CommonMC/fcl/prolog.fcl"
#include "Offline/EventGenerator/fcl/prolog.fcl"
#include "Offline/MC2Reco/fcl/prolog.fcl"
process_name : MuXrayGun
source : { module_type : EmptyEvent  firstRun : 1300 }
services : @local::Services.SimAndReco
physics : {
   producers : {
      generate                 : { module_type : EventGenerator  inputfile : @nil  allowReplacement : true  messageOnReplacement : false }
      g4run                    : @local::g4run
      CaloShowerStepMaker      : { @table::CaloMC.CaloShowerStepMaker }
      EWMProducer              : { module_type : EventWindowMarkerProducer  SpillType : 0  RecoFromMCTruth : false }
      CaloShowerROMaker        : { @table::CaloMC.CaloShowerROMaker caloShowerStepCollection : [ "CaloShowerStepMaker" ] }
      MC2CaloDigiMaker         : { @table::CaloMC.CaloDigiMaker
                                   pulseCache    : { @table::CaloMC.CaloDigiMaker.pulseCache fileName : "Offline/MC2Reco/data/sim/pulse_cosmic_r125328_v2.root" }
                                   thresholdFile : "Offline/MC2Reco/data/sim/sim_thresholds_r125329.csv"
                                   thresholdColumn : "thrRaw_adc"
                                   nSamplesBelowThr : 58 }
      MC2CaloRecoDigiMaker     : { @table::MC2Reco.MC2CaloRecoDigiMaker caloDigiCollection : MC2CaloDigiMaker useCalCalibTimeOffset : true }
      MC2CaloHitMaker          : { @table::CaloReco.CaloHitMaker caloRecoDigiCollection : MC2CaloRecoDigiMaker time4Merge : 50. }
   }
   p1  : [ generate, g4run, CaloShowerStepMaker, EWMProducer, CaloShowerROMaker, MC2CaloDigiMaker, MC2CaloRecoDigiMaker, MC2CaloHitMaker ]
   analyzers : { xray : { module_type : MC2MuXrayAna  simParticles : "g4run"  caloShowerSteps : "CaloShowerStepMaker"  caloHits : "MC2CaloHitMaker" } }
   ana : [ xray ]
   trigger_paths : [ p1 ]
   end_paths     : [ ana ]
}
services.GeometryService.inputFile  : "Offline/MC2Reco/data/geom/geom_extracted_mc2kpp.txt"
services.GeometryService.bFieldFile : "Offline/Mu2eG4/geom/bfgeom_no_field.txt"
services.ProditionsService.calSimParams.fileName : "Offline/MC2Reco/data/sim/CalSimCrystals_r125329_laser_fcl.txt"
services.ProditionsService.calSimParams.useDb : false
services.ProditionsService.calCalib.useDb : true
services.DbService.textFile : [ "Offline/MC2Reco/data/sim/CalEnergyCalib_r125329_sim.txt", "Offline/MC2Reco/data/sim/CalTimeCalib_zero.txt" ]
services.scheduler.wantSummary : true
